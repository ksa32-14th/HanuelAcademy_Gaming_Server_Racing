{
  "rules": {
    "top5": {
      "$track": {
        ".read": true,
        ".write": "newData.exists() && !newData.child('5').exists()"
      }
    },
    "sec3": {
      "$track": {
        ".read": true,
        ".write": "newData.exists() && !newData.child('s1').child('3').exists() && !newData.child('s2').child('3').exists() && !newData.child('s3').child('3').exists()"
      }
    },
    "ai": {
      "$track": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['sig', 'f', 't', 'at']) && newData.child('f').child('3').exists() && !newData.child('f').child('4').exists() && !newData.child('t').child('4').exists()"
      }
    },
    "ghost": {
      "$track": {
        ".read": true,
        "$at": {
          ".write": true,
          ".validate": "newData.hasChildren(['at', 'p'])"
        }
      }
    }
  }
}
